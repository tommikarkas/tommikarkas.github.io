---
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/tags', label: 'Tags' },
	{ href: '/about', label: 'About' },
];

function isCurrent(href: string): boolean {
	if (href === '/') return pathname === '/' || pathname === '';
	return pathname === href || pathname.startsWith(`${href}/`);
}

const [firstWord, ...rest] = SITE_TITLE.split(' ');
const lastWord = rest.join(' ');
---

<header class="nt-header nt-wrap-wide">
	<a class="nt-brand" href="/">
		<img src="/assets/nt-mark.svg" width="24" height="24" alt="" />
		<span class="nt-brand-name">{firstWord}<b>{lastWord}</b></span>
	</a>
	<nav aria-label="Site">
		<ul class="nt-nav">
			{
				links.map((link) => (
					<li>
						<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
