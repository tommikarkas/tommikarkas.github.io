---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { readingTimeMinutes } from '../lib/reading-time';

type Props = CollectionEntry<'blog'>['data'] & {
	body?: string;
	prev?: CollectionEntry<'blog'> | null;
	next?: CollectionEntry<'blog'> | null;
	/** Hide PostNav and Comments for non-post pages (e.g. About). */
	isPost?: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags,
	body,
	prev = null,
	next = null,
	isPost = true,
} = Astro.props;

const minutes = readingTimeMinutes(body);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="nt-wrap">
			<article>
				<header class="nt-post-header">
					{isPost && (
						<p class="nt-eyebrow">
							<time datetime={pubDate.toISOString()}>{pubDate.toISOString().slice(0, 10)}</time>
							{` · ${minutes} min read`}
							{updatedDate && (
								<>
									{' · '}
									<span class="nt-badge nt-cyan">
										Updated {updatedDate.toISOString().slice(0, 10)}
									</span>
								</>
							)}
						</p>
					)}
					<h1>{title}</h1>
					{description && <p class="nt-lead">{description}</p>}
					{
						tags && tags.length > 0 && (
							<ul class="nt-tags">
								{tags.map((tag) => (
									<li>
										<a class="nt-tag" href={`/tags/${tag}/`}>
											{tag}
										</a>
									</li>
								))}
							</ul>
						)
					}
				</header>
				<div class="nt-prose">
					<slot />
				</div>
			</article>

			{
				isPost && (prev || next) && (
					<nav class="nt-postnav" aria-label="Adjacent posts">
						{prev && (
							<a class="nt-prev" href={`/blog/${prev.id}/`}>
								<span class="nt-eyebrow">Previous</span>
								<strong>{prev.data.title}</strong>
							</a>
						)}
						{next && (
							<a class="nt-next" href={`/blog/${next.id}/`}>
								<span class="nt-eyebrow nt-no-prompt">Next</span>
								<strong>{next.data.title}</strong>
							</a>
						)}
					</nav>
				)
			}

			{isPost && <Comments />}
		</main>
		<Footer />
	</body>
</html>
